<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dogs_navigation"
    app:startDestination="@id/feedFragment">

    <fragment
        android:id="@+id/feedFragment"
        android:name="com.example.dogsapp.view.FeedFragment"
        android:label="FeedFragment" >
        <action
            android:id="@+id/action_feedFragment_to_dogsFragment"
            app:destination="@id/dogsFragment" />
    </fragment>
    <fragment
        android:id="@+id/dogsFragment"
        android:name="com.example.dogsapp.view.DogsFragment"
        android:label="DogsFragment" >
        <action
            android:id="@+id/action_dogsFragment_to_feedFragment"
            app:destination="@id/feedFragment" />
        <argument
            android:name="dogs_id"
            app:argType="integer"
            android:defaultValue="0" />
    </fragment>
</navigation>